# Server-side ONLY. Never prefix with VITE_ — DATABASE_URL must never reach
# the browser bundle. Get this from your Neon project dashboard:
# postgres://<user>:<password>@<host>/<db>?sslmode=require
DATABASE_URL=

# Port for the server-side API (server/index.ts). Defaults to 3001.
PORT=3001

# Optional client-side override for the API base URL. This is safe to expose:
# it is just a URL, it contains no credentials.
VITE_API_URL=http://localhost:3001
